# Скопируйте этот файл в .env и заполните своими значениями.
# .env НЕЛЬЗЯ коммитить в git.

# Токен бота из @BotFather (обязательно)
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Ваш Telegram ID — полный доступ (узнать: /myid в боте)
# Можно несколько ID через запятую: 123456789,987654321
ADMIN_IDS=

# Пользователи, которым разрешён доступ к боту.
# Если пусто — бот открыт для всех (в логе будет предупреждение).
ALLOWED_USER_IDS=

# Необязательные настройки путей (по умолчанию — рядом с config.py)
# DB_PATH=acts.db
# PROJECT_DIR=project
# ACTS_DIR=acts
# TEMPLATE_PATH=shablonact.docx
# MAX_TELEGRAM_SIZE_MB=50
